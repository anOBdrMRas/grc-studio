{
  "name": "grc-ui-assets",
  "private": true,
  "description": "Build-time dependencies of the GRC Studio interface (nothing of this runs in production)",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "css": "node scripts/build-css.mjs",
    "build": "node scripts/vendor.mjs && node scripts/build-richtext.mjs && node scripts/build-css.mjs",
    "watch": "node scripts/build-css.mjs --watch",
    "richtext": "node scripts/build-richtext.mjs"
  },
  "devDependencies": {
    "@alpinejs/csp": "3.14.9",
    "@fontsource/ibm-plex-sans": "5.1.1",
    "@fontsource/manrope": "5.1.1",
    "@tabler/icons": "3.29.0",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-highlight": "3.34.0",
    "@tiptap/extension-image": "3.34.0",
    "@tiptap/extension-table": "3.34.0",
    "@tiptap/extension-text-align": "3.34.0",
    "@tiptap/extensions": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "bpmn-js": "18.6.1",
    "daisyui": "4.12.23",
    "esbuild": "0.25.11",
    "htmx.org": "2.0.4",
    "sortablejs": "1.15.6",
    "tailwindcss": "3.4.17"
  }
