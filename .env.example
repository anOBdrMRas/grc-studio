# GRC Studio – configuration of docker-compose.yml.
# Copy to .env (or run: uv run python scripts/init_env.py) and replace every CHANGE_ME.
# .env holds secrets: never commit it.

# --- database -------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME

# --- address ----------------------------------------------------------------
# public address of the application as users open it; https:// switches on secure cookies and HSTS
PUBLIC_BASE_URL=http://localhost:8080
# host interface and port of the entry proxy (127.0.0.1 = this machine only; 0.0.0.0 only behind TLS)
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# --- sign-in ----------------------------------------------------------------
# true: sign-in by choosing a person (demo, no password) – only for demos with test data
# false: sign-in with user name and password
DEMO_LOGIN=true
# first administrator with password, created at start if missing (leave empty for none)
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
SESSION_TTL_HOURS=12

# --- data -------------------------------------------------------------------
# load the pseudonymised demo data when the database is empty
SEED_DEMO_ON_EMPTY=true

# --- interface --------------------------------------------------------------
DEFAULT_LANGUAGE=de
LOG_LEVEL=INFO

# --- images (optional) ------------------------------------------------------
# prebuilt images instead of a local build, e.g. ghcr.io/anobdrmras/grc-studio-api:0.1.0
# API_IMAGE=
# UI_IMAGE=
